# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/trakl

# Dedalus Labs Configuration
DEDALUS_API_KEY=your_dedalus_api_key_here
DEDALUS_MODEL=openai/gpt-4o-mini

# External Services
REC_SERVICE_URL=http://localhost:8001

# Google Calendar Integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8002/api/calendar/callback

# Session Management
DEFAULT_SESSION_DURATION=30
MAX_SESSIONS_PER_DAY=8

# Progress Tracking
PROGRESS_UPDATE_INTERVAL=24
